# Database Configuration
# IMPORTANT: Copy this file to .env and update with your actual values

# Database Host (use 'localhost' for local development, or container IP for Docker)
DB_HOST=localhost

# Database Port
DB_PORT=5432

# Database User
DB_USER=your_db_user

# Database Password (⚠️ DO NOT commit .env with real passwords!)
DB_PASSWORD=your_secure_password_here

# Database Name
DB_NAME=your_db_name

# Prisma Connection URL
# This uses the variables defined above (do NOT hardcode credentials here)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public"

# Optional: For production with SSL
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public&sslmode=require"
